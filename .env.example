# Copy to .env and fill values. Never commit .env.

ENVIRONMENT=development
APP_SECRET_KEY=change-me
TOKEN_ENCRYPTION_KEY=change-me-32bytes-min
# Studio gate PIN — required on the access screen + every API call
PORTAL_ACCESS_KEY=0214
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MEDIA_ROOT=/app/storage
MAX_UPLOAD_BYTES=524288000

POSTGRES_USER=ragam
POSTGRES_PASSWORD=ragam
POSTGRES_DB=ragam
DATABASE_URL=postgresql+psycopg://ragam:ragam@postgres:5432/ragam
REDIS_URL=redis://redis:6379/0

# --- LLM: Gemini lyrics (text) ---
# LLM — gemini (default) | cursor | openai | auto
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_ENABLED=false

CURSOR_API_KEY=
CURSOR_LLM_MODEL=composer-2.5
CURSOR_IMAGE_MODEL=composer-2.5
LYRICS_AGENT_URL=http://lyrics-agent:8020
LYRICS_AGENT_TIMEOUT_SEC=180
CURSOR_IMAGE_TIMEOUT_SEC=300
LYRICS_BACKEND=auto
CURSOR_CLI_PATH=

# --- Music: official Mureka ---
MUREKA_API_KEY=
MUREKA_BASE_URL=https://api.mureka.ai
MUREKA_MODEL=auto

# Optional backups
WAVESPEED_API_KEY=
WAVESPEED_BASE_URL=https://api.wavespeed.ai
WAVESPEED_MUSIC_MODEL=wavespeed-ai/ace-step-1.5
SUNOAPI_API_KEY=

# --- Kling: thumbnails + video (paid) ---
KLING_API_KEY=
KLING_BASE_URL=https://api-singapore.klingai.com
KLING_IMAGE_MODEL=kling-v3-omni
KLING_IMAGE_RESOLUTION=4k
KLING_IMAGE_TIMEOUT_SEC=240
# Flagship Trial / Flagship packs: use kling-4.0 or kling-4.0-flash (not 2.5 Turbo)
KLING_VIDEO_MODEL=kling-4.0
KLING_VIDEO_DURATION=10
KLING_VIDEO_RESOLUTION=720p
KLING_VIDEO_ASPECT_RATIO=16:9
KLING_VIDEO_AUDIO=off
KLING_VIDEO_TIMEOUT_SEC=900
# auto = Gemini video first, Kling on quota/fail; or force gemini | kling
VIDEO_PROVIDER=auto
# scenes = hero stills → animate → FFmpeg assemble (recommended, cheaper)
# singleshot = one long AI video clip (legacy / expensive)
VIDEO_PIPELINE=scenes
VIDEO_SCENE_COUNT=12
VIDEO_SCENE_CLIP_SEC=15
# kenburns ($0) | auto (Kling i2v then Ken Burns) | kling_i2v
VIDEO_SCENE_ANIMATE=kenburns
# Long-form silent visual min length (mild slow + soft loops; not jerky 6× stretch)
VIDEO_MAIN_MIN_SEC=45
# Mix volume bump (loudness only — does not change tempo/pitch)
AUDIO_TARGET_MEAN_DB=-12
AUDIO_QUIET_BELOW_DB=-16
AUDIO_MAX_BOOST_DB=10
# Auto prep (video+mix) this many minutes before publish_at
PREP_LEAD_MINUTES=60
PREP_GRACE_MINUTES=15
# Short 1 with main video; Short 2 publishes this many hours later
SHORT_STAGGER_HOURS=5
# 1 = one Short with main video (default); 2 = also cut Short 2 later
SHORTS_COUNT=1

# --- YouTube OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://youtube-auto.sigwent.com/api/v1/youtube/callback
GOOGLE_PROJECT_ID=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_HANDLE=
YOUTUBE_CHANNEL_URL=

# --- n8n ---
N8N_WEBHOOK_SECRET=change-me-n8n-webhook
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

BACKEND_URL=http://backend:8000
FRONTEND_URL=http://localhost:5173
